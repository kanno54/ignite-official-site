# IGNITE Official Site Environment Configuration Example
# Copy to .env.local or set in your hosting platform

# Base Path for deployment (e.g. / or /ignite/)
VITE_BASE_PATH=/

# Staging Environment Flag (true disables public GA analytics & enables staging features)
VITE_STAGING=false

# Canonical Site URL
VITE_SITE_URL=https://ignite-official.site

# Google Analytics 4 Measurement ID (Production only)
VITE_GA_MEASUREMENT_ID=G-GCTZZX9HFR

# Analytics Enable Flag (set to true in production environment only)
VITE_ENABLE_ANALYTICS=true
